    "# ============================================================================\n",
    "# STEP 3: TRAIN BASELINE FL MODEL (no privacy) AND ATTACK IT\n",
    "# This gives the comparison row in privacy table\n",
    "# ============================================================================\n",
    "\n",
    "print(\"Training Standard FL baseline (no privacy) for MIA comparison...\")\n",
    "print(\"This uses 3 rounds, same as MedHE.\\n\")\n",
    "\n",
    "baseline_model = DistilBertForSequenceClassification.from_pretrained(\n",
    "    'distilbert-base-uncased', num_labels=2\n",
    ").to(device)\n",
    "\n",
    "for round_num in range(3):\n",
    "    print(f\"  Baseline FL Round {round_num+1}/3...\")\n",
    "    client_updates = []\n",
    "    \n",
    "    for loader in client_loaders:\n",
    "        local_model = DistilBertForSequenceClassification.from_pretrained(\n",
    "            'distilbert-base-uncased', num_labels=2\n",
    "        ).to(device)\n",
    "        local_model.load_state_dict(baseline_model.state_dict())\n",
    "        \n",
    "        optimizer = torch.optim.Adam(local_model.parameters(), lr=1e-4)\n",
    "        local_model.train()\n",
    "        \n",
    "        for epoch in range(2):\n",
    "            for batch in client_loaders[0]:  \n",
    "                input_ids = batch['input_ids'].to(device)\n",
    "                attention_mask = batch['attention_mask'].to(device)\n",
    "                labels_b = batch['labels'].to(device)\n",
    "                \n",
    "                optimizer.zero_grad()\n",
    "                outputs = local_model(\n",
    "                    input_ids=input_ids,\n",
    "                    attention_mask=attention_mask,\n",
    "                    labels=labels_b\n",
    "                )\n",
    "                outputs.loss.backward()\n",
    "                optimizer.step()\n",
    "        \n",
    "        client_updates.append(local_model.state_dict())\n",
    "    \n",
    "    # FedAvg aggregate\n",
    "    avg_state = {}\n",
    "    for key in client_updates[0].keys():\n",
    "        avg_state[key] = torch.stack(\n",
    "            [u[key].float() for u in client_updates]\n",
    "        ).mean(0)\n",
    "    baseline_model.load_state_dict(avg_state)\n",
    "\n",
    "print(\"\\nBaseline FL training complete. Running MIA...\")\n",
    "\n",
    "# Get predictions from baseline model\n",
    "baseline_member_probs, _ = get_prediction_vector(baseline_model, member_loader, device)\n",
