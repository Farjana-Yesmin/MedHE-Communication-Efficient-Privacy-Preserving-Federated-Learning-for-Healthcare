    "baseline_mia_results, baseline_worst = run_all_mia_attacks(\n",
    "    baseline_model,\n",
    "    baseline_member_probs,\n",
    "    baseline_nonmember_probs,\n",
    "    \"Standard FL (no privacy)\"\n",
