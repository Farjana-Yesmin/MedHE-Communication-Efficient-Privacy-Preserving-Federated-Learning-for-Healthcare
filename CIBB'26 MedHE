    "# STEP 2: RUN MEMBERSHIP INFERENCE ATTACKS\n",
    "# We implement 4 standard attacks from the literature\n",
    "# ============================================================================\n",
    "\n",
    "def run_all_mia_attacks(model, member_probs, nonmember_probs, method_name):\n",
    "    \"\"\"\n",
    "    Run 4 standard MIA attacks and return success rates.\n",
    "    \n",
    "    Attack 1: Confidence threshold (Shokri et al. 2017)\n",
    "      - If max confidence > threshold → predict member\n",
    "    Attack 2: Entropy threshold\n",
    "      - If prediction entropy < threshold → predict member  \n",
    "    Attack 3: Modified entropy (Song & Mittal 2021)\n",
    "      - Uses modified entropy accounting for true label\n",
    "    Attack 4: Shadow model / ML attack (Shokri et al. 2017)\n",
    "      - Train a logistic regression to classify member vs non-member\n",
    "    \"\"\"\n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"MIA RESULTS FOR: {method_name}\")\n",
    "    print(f\"{'='*60}\")\n",
    "    \n",
    "    # Balance the dataset - use min size to avoid bias\n",
    "    n_members = len(member_probs)\n",
    "    n_nonmembers = len(nonmember_probs)\n",
    "    n = min(n_members, n_nonmembers)\n",
    "    \n",
    "    # Randomly sample equal numbers\n",
    "    np.random.seed(42)\n",
    "    m_idx = np.random.choice(n_members, n, replace=False)\n",
    "    nm_idx = np.random.choice(n_nonmembers, n, replace=False)\n",
    "    \n",
    "    m_probs = member_probs[m_idx]      # shape (n, 2)\n",
    "    nm_probs = nonmember_probs[nm_idx]  # shape (n, 2)\n",
    "    \n",
    "    # Labels: 1=member, 0=non-member\n",
    "    labels = np.array([1]*n + [0]*n)\n",
    "    \n",
    "    results = {}\n",
    "    \n",
    "    # --- Attack 1: Max confidence threshold ---\n",
    "    max_conf_members = m_probs.max(axis=1)\n",
    "    max_conf_nonmembers = nm_probs.max(axis=1)\n",
    "    \n",
    "    # Find best threshold on half the data, evaluate on other half\n",
    "    all_conf = np.concatenate([max_conf_members, max_conf_nonmembers])\n",
    "    thresholds = np.percentile(all_conf, np.arange(10, 91, 5))\n",
    "    best_acc = 0\n",
    "    best_thresh = 0.5\n",
    "    for t in thresholds:\n",
    "        preds = (all_conf >= t).astype(int)\n",
    "        acc = accuracy_score(labels, preds)\n",
    "        if acc > best_acc:\n",
    "            best_acc = acc\n",
    "            best_thresh = t\n",
    "    \n",
    "    attack1_preds = (all_conf >= best_thresh).astype(int)\n",
    "    attack1_acc = accuracy_score(labels, attack1_preds)\n",
    "    results['confidence_threshold'] = attack1_acc\n",
    "    print(f\"Attack 1 - Max Confidence Threshold: {attack1_acc:.4f} ({attack1_acc*100:.1f}%)\")\n",
    "    \n",
    "    # --- Attack 2: Entropy threshold ---\n",
    "    def entropy(probs):\n",
    "        probs = np.clip(probs, 1e-10, 1.0)\n",
    "        return -np.sum(probs * np.log(probs), axis=1)\n",
    "    \n",
    "    ent_members = entropy(m_probs)\n",
    "    ent_nonmembers = entropy(nm_probs)\n",
    "    all_ent = np.concatenate([ent_members, ent_nonmembers])\n",
    "    \n",
    "    # Low entropy = high confidence = likely member\n",
    "    best_acc_ent = 0\n",
    "    best_thresh_ent = 0.5\n",
    "    for t in np.percentile(all_ent, np.arange(10, 91, 5)):\n",
    "        preds = (all_ent <= t).astype(int)  # low entropy → member\n",
    "        acc = accuracy_score(labels, preds)\n",
    "        if acc > best_acc_ent:\n",
    "            best_acc_ent = acc\n",
    "            best_thresh_ent = t\n",
    "    \n",
    "    attack2_preds = (all_ent <= best_thresh_ent).astype(int)\n",
    "    attack2_acc = accuracy_score(labels, attack2_preds)\n",
    "    results['entropy_threshold'] = attack2_acc\n",
    "    print(f\"Attack 2 - Entropy Threshold:         {attack2_acc:.4f} ({attack2_acc*100:.1f}%)\")\n",
    "    \n",
    "    # --- Attack 3: Modified entropy (using predicted class, not true label) ---\n",
    "    pred_classes = np.argmax(m_probs, axis=1)\n",
    "    pred_classes_nm = np.argmax(nm_probs, axis=1)\n",
    "    \n",
    "    def modified_entropy(probs, pred_class):\n",
    "        n = len(probs)\n",
    "        ment = np.zeros(n)\n",
    "        for i in range(n):\n",
    "            p = probs[i]\n",
    "            y = pred_class[i]\n",
    "            term1 = (1 - p[y]) * np.log(p[y] + 1e-10)\n",
    "            term2 = sum(p[j] * np.log(p[j] + 1e-10) \n",
    "                       for j in range(len(p)) if j != y)\n",
    "            ment[i] = -(term1 + term2)\n",
    "        return ment\n",
    "    \n",
    "    ment_m = modified_entropy(m_probs, pred_classes)\n",
    "    ment_nm = modified_entropy(nm_probs, pred_classes_nm)\n",
    "    all_ment = np.concatenate([ment_m, ment_nm])\n",
    "    \n",
    "    best_acc_ment = 0\n",
    "    best_thresh_ment = 0.5\n",
    "    for t in np.percentile(all_ment, np.arange(10, 91, 5)):\n",
    "        preds = (all_ment <= t).astype(int)\n",
    "        acc = accuracy_score(labels, preds)\n",
    "        if acc > best_acc_ment:\n",
    "            best_acc_ment = acc\n",
    "            best_thresh_ment = t\n",
    "    \n",
    "    attack3_preds = (all_ment <= best_thresh_ment).astype(int)\n",
    "    attack3_acc = accuracy_score(labels, attack3_preds)\n",
    "    results['modified_entropy'] = attack3_acc\n",
    "    print(f\"Attack 3 - Modified Entropy:           {attack3_acc:.4f} ({attack3_acc*100:.1f}%)\")\n",
    "    \n",
    "    # --- Attack 4: Shadow / ML classifier attack ---\n",
    "    # Features: full softmax probability vector\n",
    "    X = np.vstack([m_probs, nm_probs])  # (2n, num_classes)\n",
    "    y = labels\n",
    "    \n",
    "    # Split into train/test for the attack classifier itself\n",
    "    X_train, X_test, y_train, y_test = train_test_split(\n",
    "        X, y, test_size=0.4, random_state=42, stratify=y\n",
    "    )\n",
    "    \n",
    "    attack_clf = LogisticRegression(max_iter=1000, random_state=42)\n",
    "    attack_clf.fit(X_train, y_train)\n",
    "    attack4_preds = attack_clf.predict(X_test)\n",
    "    attack4_acc = accuracy_score(y_test, attack4_preds)\n",
    "    results['ml_attack'] = attack4_acc\n",
    "    print(f\"Attack 4 - ML Classifier Attack:       {attack4_acc:.4f} ({attack4_acc*100:.1f}%)\")\n",
    "    \n",
    "    # Overall: worst case (highest attacker success)\n",
    "    worst_case = max(results.values())\n",
    "    print(f\"\\n>>> WORST-CASE MIA SUCCESS RATE: {worst_case:.4f} ({worst_case*100:.1f}%)\")\n",
    "    print(f\">>> Random guess baseline:        0.5000 (50.0%)\")\n",
    "    print(f\">>> Privacy gain over random:     {(worst_case - 0.5)*100:+.1f}%\")\n",
    "    \n",
    "    return results, worst_case\n",
    "\n",
    "# Run on MedHE (the trained global_model)\n",
    "medhe_mia_results, medhe_worst = run_all_mia_attacks(\n",
    "    global_model, member_probs, nonmember_probs, \"MedHE (trained model)\"\n",
    ")"
   ]
